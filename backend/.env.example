# AQRTI backend environment — copy to backend/.env and fill in real values.
# NEVER commit the real .env (it is gitignored).

# LLM providers (free tiers)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_RATE_LIMIT_RPM=40
NVIDIA_NIM_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
AQRTI_LLM_PROVIDER=nvidia_nim

# Optional
AQRTI_FINNHUB_API_KEY=
# AQRTI_TELEGRAM_BOT_TOKEN=
# AQRTI_TELEGRAM_CHAT_ID=
# AQRTI_OBSIDIAN_VAULT_PATH=
