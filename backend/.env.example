# AQRTI Backend — Environment Configuration
# Copy this to .env and fill in values

# ── Server ──────────────────────────────────────────────────────
AQRTI_HOST=0.0.0.0
AQRTI_PORT=8000
AQRTI_RELOAD=true
AQRTI_LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────────────
AQRTI_DB_PATH=./aqrti.db

# ── Paper Trading ────────────────────────────────────────────────
AQRTI_PAPER_CAPITAL=100000

# ── Data ─────────────────────────────────────────────────────────
# Comma-separated list of NSE symbols to track
AQRTI_UNIVERSE=RELIANCE.NS,TCS.NS,INFY.NS,HDFCBANK.NS,ICICIBANK.NS,WIPRO.NS,AXISBANK.NS,LTIM.NS,NESTLEIND.NS,BAJFINANCE.NS,MARUTI.NS,SUNPHARMA.NS,TATASTEEL.NS,TATAMOTORS.NS,KOTAKBANK.NS,TITAN.NS,ONGC.NS,HINDALCO.NS,SBIN.NS,BHARTIARTL.NS

# ── Indices ──────────────────────────────────────────────────────
AQRTI_INDICES=^NSEI,^NSEBANK,NIFTYIT.NS

# ── Scheduler ────────────────────────────────────────────────────
# Cron: run daily data ingestion after market close (IST = UTC+5:30)
AQRTI_INGEST_CRON=30 15 * * 1-5
